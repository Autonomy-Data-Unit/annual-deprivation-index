# Web server for the ADI site, replacing AppGarden's built-in static hosting.
#
# AppGarden's `static` method renders a fixed Caddy block with a bare
# `file_server` and no compression, and falls back to /index.html for ANY
# unknown path — so a 1.2 MB JSON shipped uncompressed (Explorer blank for
# ~25s on a slow line, #38) and every dead URL returned HTTP 200 (#44).
# There is no per-app override, so we serve the site ourselves and AppGarden
# simply reverse-proxies to us.
:8080 {
	root * /srv
	encode zstd gzip

	# Prerendered routes are real directories (trailingSlash=always), so
	# {path}/index.html resolves them. No blanket fallback: an unknown path
	# must 404, not silently return the homepage.
	try_files {path} {path}/index.html
	file_server {
		precompressed br gzip
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}

	# Generated data and bundles are content-stable between releases and
	# safe to cache; HTML is not, because a redeploy must be picked up.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@data path /data/* /downloads/* /geo/* /tiles/*
	header @data Cache-Control "public, max-age=3600"
}
